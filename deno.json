{
  "tasks": {
    "ffmpeg-build": "deno run --allow-net=ffmpeg.org --allow-read --allow-write --allow-env=TMPDIR,PATH --allow-run=bash,make,tar,otool,install_name_tool,codesign,clang,zip,ditto tools/ffmpeg/build.ts",
    "ffmpeg-verify": "deno run --allow-read --allow-write --allow-env=TMPDIR --allow-run=ditto,plutil,otool,file,codesign,clang,diff tools/ffmpeg/verify.ts"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "include": [
      "tools/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
